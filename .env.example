# NetEase Cloud Music Cookie
# Get MUSIC_U: Browser F12 -> Application -> Cookies -> music.163.com -> MUSIC_U
# Get __csrf: Browser F12 -> Application -> Cookies -> music.163.com -> __csrf
NETEASE_COOKIE=MUSIC_U=your_music_u_here; __csrf=your_csrf_here

# Random server-to-server bearer token for MCP clients and the Xiaowo Worker.
# This is not a second NetEase login and must never be placed in browser code.
NETEASE_SERVICE_TOKEN=replace_with_a_long_random_value

# MCP Server Port
MCP_PORT=3456

# Optional tinggu URL-analysis bridge. Companion and VPS never receive these.
# Playback remains fail-open if they are missing or tinggu is down.
TINGGU_BASE_URL=
TINGGU_BRIDGE_TOKEN=
